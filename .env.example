# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://10.0.1.15:3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ibamhealth

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Termii (SMS / OTP)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=IBamHealth

# SMTP (Nodemailer) — use port 465 + SMTP_SECURE=true for direct SSL, or 587 + SMTP_SECURE=false for STARTTLS
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@ibamhealth.com
# SMTP_PASS=your_smtp_password
# SMTP_REJECT_UNAUTHORIZED=true   ← set false only in dev if cert is self-signed

# SendGrid (Email — used if SMTP vars are absent)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@ibamhealth.com

# Agora (Video / Audio calls)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Paystack (Payments)
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_CALLBACK_URL=http://10.0.1.15:3000/payment/verify

# Platform settings
PLATFORM_CUT_PERCENT=20

# Dojah (KYC — NIN, face match, CAC verification)
# Sign up at https://app.dojah.io — sandbox is free for testing
DOJAH_APP_ID=your_dojah_app_id
DOJAH_PRIVATE_KEY=your_dojah_private_key

# Google OAuth (used for web + mobile sign-in)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: ${SERVER_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# PUBLIC URL of this server (no trailing slash) — used to build the OAuth callback URL
SERVER_URL=http://10.0.1.44:5000

# Google Maps API key
# Used for: map embeds and directions links on the web client
# NOT required for facility search (that uses OpenStreetMap/Overpass — free, no key)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Expo Push Notifications
# Get this from https://expo.dev → Project settings → Access Tokens
# Optional for basic delivery; required for enhanced priority & receipts
EXPO_ACCESS_TOKEN=your_expo_access_token
# Run "eas init" in /mobile to get your EAS project ID, then add it to mobile/app.json under extra.eas.projectId

# Admin seed account (used by the DB seeder / first-run script)
ADMIN_EMAIL=admin@ibamhealth.com
ADMIN_PASSWORD=ChangeMe_S3cure!

# Resend (transactional email — alternative to SendGrid/SMTP)
# Sign up at https://resend.com — use with FROM address you've verified
RESEND_API_KEY=re_your_resend_api_key

# KYC bypass — set to "true" in development to skip Dojah API calls
# NEVER set this in production
DOJAH_BYPASS=false
